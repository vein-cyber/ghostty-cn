          }
        }
      }
    },
    "The momentum phase for inertial scrolling.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "惯性滚动的惯性阶段。"
          }
        }
      }
    },
    "The mouse button to press or release.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要按下或松开的鼠标按钮。"
          }
        }
      }
    },
    "The renderer has failed. This is usually due to exhausting available GPU memory. Please free up available resources.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "渲染器运行失败。这通常是可用 GPU 内存耗尽所致。请释放一些资源。"
          }
        }
      }
    },
    "The target contains invisible or line-breaking characters.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标包含不可见字符或换行字符。"
          }
        }
      }
    },
    "The target is not an absolute URL with a scheme.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标不是包含方案的绝对 URL。"
          }
        }
      }
    },
    "The terminal failed to initialize. Please check the logs for more information. This is usually a bug.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端初始化失败。请检查日志以获取更多信息。这通常是程序错误。"
          }
        }
      }
    },
    "The terminal no longer exists.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该终端已不存在。"
          }
        }
      }
    },
    "The terminal still has a running process. If you close the tab the process will be killed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端中仍有进程在运行。关闭标签页将终止该进程。"
          }
        }
      }
    },
    "The terminal still has a running process. If you close the terminal the process will be killed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端中仍有进程在运行。关闭终端将终止该进程。"
          }
        }
      }
    },
    "The terminal still has a running process. If you quit, the process will be killed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端中仍有进程在运行。退出将终止该进程。"
          }
        }
      }
    },
    "The terminal to base available commands from.": {
