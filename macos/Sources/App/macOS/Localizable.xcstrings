    "A key press or release.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键的按下或松开操作。"
          }
        }
      }
    },
    "A key sequence is a series of key presses that trigger an action. A pending key sequence is currently active.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键序列是用于触发操作的一系列按键。当前有一个待完成的按键序列处于活动状态。"
          }
        }
      }
    },
    "A key table is a named set of keybindings, activated by some other key. Keys are interpreted using this table until it is deactivated.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键表是一组有名称的快捷键绑定，由另一个按键激活。在停用之前，所有按键都将按此表解释。"
          }
        }
      }
    },
    "Action": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作"
          }
        }
      }
    },
    "All terminal sessions in this window will be terminated.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口内所有运行中的进程将被终止。"
          }
        }
      }
    },
    "All terminal sessions will be terminated.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端内所有运行中的进程将被终止。"
          }
        }
      }
    },
    "Allow": {
      "comment": "Button that allows clipboard access\nPermission dialog allow button",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许"
          }
        }
      }
    },
