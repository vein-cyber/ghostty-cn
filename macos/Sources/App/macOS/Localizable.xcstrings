      }
    },
    "The horizontal scroll amount.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水平滚动量。"
          }
        }
      }
    },
    "The key to send to the terminal.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要发送到终端的按键。"
          }
        }
      }
    },
    "The keybind action to invoke. This can be any valid keybind action you could put in a configuration file.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要调用的快捷键操作。可以是配置文件中可用的任何有效快捷键操作。"
          }
        }
      }
    },
    "The local target does not exist or is not a regular file or directory.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地目标不存在，或者不是普通文件或目录。"
          }
        }
      }
    },
    "The location that the terminal should be created.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要创建终端的位置。"
          }
        }
      }
    },
    "The modifiers to send with the key event.": {
      "localizations": {
        "zh-Hans": {
