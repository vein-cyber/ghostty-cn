new file mode 100644
index 0000000..6575a15
--- /dev/null
+++ b/src/lib/components/NativeToolbar.svelte
@@ -0,0 +1,142 @@
+<script lang="ts">
+    import {onMount} from "svelte";
+
+    import Button from "$lib/components/Button.svelte";
+    import {registry} from "$lib/settings/registry";
+    import {diff, load} from "$lib/stores/config.svelte";
+    import {error, success} from "$lib/stores/toasts.svelte";
+    import {
+        isNativeHost,
+        observeNativeConfig,
+        observeNativeResult,
+        openNativeConfigFile,
+        requestNativeConfig,
+        saveNativeConfig
+    } from "$lib/native";
+    import {parse, serialize} from "$lib/utils/parse";
+    import {isChinese} from "$lib/i18n";
+
+    const nativeHost = isNativeHost();
+    const excludedKeys = new Set([
+        "auto-update",
+        "auto-update-channel",
+        "config-default-files",
+        "config-file"
+    ]);
+    const managedKeys = Object.values(registry)
+        .map(setting => setting.key)
+        .filter(key => !excludedKeys.has(key));
+
+    let configPath = $state("");
+    let saving = $state(false);
+
+    const strings = $derived.by(() => {
+        return isChinese() ? {
+            apply: "应用并重新加载",
+            edit: "编辑原始配置",
+            loaded: "已载入当前 Ghostty 配置",
+            loading: "正在载入当前配置…",
+            saveFailed: "保存配置失败",
+            saving: "正在保存…"
+        } : {
+            apply: "Apply & Reload",
+            edit: "Edit Raw Config",
+            loaded: "Current Ghostty configuration loaded",
+            loading: "Loading current configuration…",
+            saveFailed: "Failed to save configuration",
+            saving: "Saving…"
+        };
+    });
+
+    onMount(() => {
+        if (!nativeHost) return;
+        document.documentElement.classList.add("ghostty-native-host");
+
+        const stopConfig = observeNativeConfig(({content, path}) => {
+            try {
+                load(parse(content));
+                configPath = path;
+                success(strings.loaded);
+            }
+            catch {
+                error(strings.saveFailed);
+            }
+        });
+        const stopResult = observeNativeResult(({message, ok}) => {
+            saving = false;
+            if (ok) success(message);
+            else error(message);
+        });
+
+        requestNativeConfig();
+        return () => {
+            document.documentElement.classList.remove("ghostty-native-host");
+            stopConfig();
+            stopResult();
+        };
+    });
+
+    function apply() {
+        if (saving) return;
+        saving = true;
+
+        const values = diff();
+        for (const key of excludedKeys) delete values[key];
+        saveNativeConfig(serialize(values, false), managedKeys);
+    }
+</script>
+
+{#if nativeHost}
+    <div class="native-toolbar">
+        <div class="config-path" title={configPath}>{configPath || strings.loading}</div>
+        <div class="actions">
+            <Button onclick={openNativeConfigFile}>{strings.edit}</Button>
+            <Button primary onclick={apply} disabled={saving}>{saving ? strings.saving : strings.apply}</Button>
+        </div>
+    </div>
+{/if}
+
+<style>
+.native-toolbar {
+    align-items: center;
+    background: var(--bg-level-2);
+    border-top: 1px solid var(--border-level-2);
+    display: flex;
+    flex: 0 0 50px;
+    gap: 12px;
+    justify-content: space-between;
+    padding: 0 14px;
+}
+
+.config-path {
+    color: var(--font-color-muted);
+    font-size: 0.75rem;
+    min-width: 0;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+.actions {
+    display: flex;
+    flex: none;
+    gap: 8px;
+}
+
+:global(html.ghostty-native-host body) {
+    overflow: hidden;
+}
+
+:global(html.ghostty-native-host .app-window) {
+    border: 0;
+    border-radius: 0;
+    box-shadow: none;
+    height: 100%;
+    max-width: none;
+    width: 100%;
+}
+
+:global(html.ghostty-native-host .window-actions-container) {
+    display: none !important;
+}
+</style>
