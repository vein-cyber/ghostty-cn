diff --git a/src/lib/native.ts b/src/lib/native.ts
new file mode 100644
index 0000000..ba067d1
--- /dev/null
+++ b/src/lib/native.ts
@@ -0,0 +1,57 @@
+import {browser} from "$app/environment";
+
+interface WebKitMessageHandler {
+    postMessage(message: unknown): void;
+}
+
+interface NativeLoadDetail {
+    content: string;
+    path: string;
+}
+
+interface NativeResultDetail {
+    message: string;
+    ok: boolean;
+}
+
+declare global {
+    interface Window {
+        webkit?: {
+            messageHandlers?: {
+                ghosttyConfig?: WebKitMessageHandler;
+            };
+        };
+    }
+}
+
+export function isNativeHost() {
+    return browser && Boolean(window.webkit?.messageHandlers?.ghosttyConfig);
+}
+
+function post(message: unknown) {
+    window.webkit?.messageHandlers?.ghosttyConfig?.postMessage(message);
+}
+
+export function requestNativeConfig() {
+    post({action: "ready"});
+}
+
+export function saveNativeConfig(config: string, keys: string[]) {
+    post({action: "save", config, keys});
+}
+
+export function openNativeConfigFile() {
+    post({action: "open-config-file"});
+}
+
+export function observeNativeConfig(handler: (detail: NativeLoadDetail) => void) {
+    const listener = (event: Event) => handler((event as CustomEvent<NativeLoadDetail>).detail);
+    window.addEventListener("ghostty-native-config", listener);
+    return () => window.removeEventListener("ghostty-native-config", listener);
+}
+
+export function observeNativeResult(handler: (detail: NativeResultDetail) => void) {
+    const listener = (event: Event) => handler((event as CustomEvent<NativeResultDetail>).detail);
+    window.addEventListener("ghostty-native-result", listener);
+    return () => window.removeEventListener("ghostty-native-result", listener);
+}
