+import {afterEach, describe, expect, it} from "vitest";
+
+import {getResults, setQuery} from "./search.svelte";
+
+afterEach(() => setQuery(""));
+
+describe("platform navigation search", () => {
+    it.each(["Advanced", "高级"])("finds the advanced panel using %s", (query) => {
+        setQuery(query);
+
+        const results = getResults();
+        expect(results.length).toBeGreaterThan(0);
+        expect(results.every((result) => result.categoryId === "macos")).toBe(true);
+    });
+
+    it.each(["GTK", "Linux"])("does not return a hidden %s panel", (query) => {
+        setQuery(query);
+
+        expect(getResults().every((result) => !["gtk", "linux"].includes(result.categoryId))).toBe(
+            true
+        );
+    });
+});
