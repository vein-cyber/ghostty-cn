diff --git a/src/lib/settings/navigation.test.ts b/src/lib/settings/navigation.test.ts
new file mode 100644
index 0000000..940e770
--- /dev/null
+++ b/src/lib/settings/navigation.test.ts
@@ -0,0 +1,37 @@
+import {describe, expect, it} from "vitest";
+
+import {registry} from "./registry";
+import navigation, {
+    intentionallyUncategorizedSettings,
+    resolveSettingsCategory,
+    tabGroups,
+    validateNavigation
+} from "./navigation";
+
+describe("platform navigation", () => {
+    it("shows only the renamed advanced platform panel", () => {
+        const ids = navigation.map((panel) => panel.id);
+        expect(ids).not.toContain("gtk");
+        expect(ids).not.toContain("linux");
+
+        const advanced = navigation.find((panel) => panel.id === "macos");
+        expect(advanced?.name).toBe("Advanced");
+        expect(advanced?.icon).toMatch(/^data:image\/svg\+xml/);
+        expect(tabGroups.at(-1)).toEqual(["macos"]);
+    });
+
+    it("keeps hidden platform settings registered but intentionally uncategorized", () => {
+        expect(intentionallyUncategorizedSettings.has("gtkTitlebar")).toBe(true);
+        expect(intentionallyUncategorizedSettings.has("linuxCgroup")).toBe(true);
+        for (const settingId of intentionallyUncategorizedSettings) {
+            expect(registry[settingId]).toBeDefined();
+        }
+        expect(() => validateNavigation()).not.toThrow();
+    });
+
+    it("redirects legacy platform routes to the advanced panel", () => {
+        expect(resolveSettingsCategory("gtk")).toBe("macos");
+        expect(resolveSettingsCategory("linux")).toBe("macos");
+        expect(resolveSettingsCategory("colors")).toBe("colors");
+    });
+});
