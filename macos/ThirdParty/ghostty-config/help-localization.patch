+
+export function localizeSettingDescription(
+    settingId: string | undefined,
+    description: string,
+    name: string
+): string {
+    if (!isChinese()) return description;
+
+    const localized = localizeText(description);
+    if (localized !== description) return localized;
+    if (settingId && zhHansSettingDescriptions[settingId]) {
+        return zhHansSettingDescriptions[settingId];
+    }
+
+    return `用于配置“${localizeText(name)}”。若不确定其作用，请保留默认值。`;
+}
