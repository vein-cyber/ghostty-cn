--- /dev/null
+++ b/src/lib/help-i18n.test.ts
@@ -0,0 +1,20 @@
+import {describe, expect, it} from "vitest";
+import {zhHansSettingDescriptions} from "$lib/help-i18n";
+import {navigation} from "$lib/settings/navigation";
+
+describe("Simplified Chinese setting help", () => {
+    it("covers every setting shown in navigation", () => {
+        const visibleSettingIds = navigation.flatMap((panel) =>
+            (panel.groups ?? []).flatMap((group) => [...group.settings])
+        );
+
+        expect(new Set(Object.keys(zhHansSettingDescriptions))).toEqual(
+            new Set(visibleSettingIds)
+        );
+        for (const settingId of visibleSettingIds) {
+            const description = zhHansSettingDescriptions[settingId];
+            expect(description, settingId).toBeTruthy();
+            expect(description, settingId).toMatch(/[\u3400-\u9fff]/u);
+        }
+    });
+});
